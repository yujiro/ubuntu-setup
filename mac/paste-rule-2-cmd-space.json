{
  "description": "Windows App前面時: Cmd+Space → Option+Space (Ubuntu側で ulauncher を開く)",
  "manipulators": [
    {
      "type": "basic",
      "from": {
        "key_code": "spacebar",
        "modifiers": {
          "mandatory": [
            "command"
          ]
        }
      },
      "to": [
        {
          "key_code": "spacebar",
          "modifiers": [
            "left_option"
          ]
        }
      ],
      "conditions": [
        {
          "type": "frontmost_application_if",
          "bundle_identifiers": [
            "^com\\.microsoft\\.rdc\\.macos$"
          ]
        }
      ]
    }
  ]
}
